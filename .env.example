# football-data.org API key — server only, never exposed to the client.
FOOTBALL_DATA_API_KEY=your_football_data_org_key_here

# Vercel KV credentials (Upstash Redis under the hood). Provision a KV
# instance from the Vercel dashboard, then copy these from the
# Settings → Storage tab. If left blank, the proxy falls back to direct
# upstream fetches with no caching — fine for local UI work, NOT for prod.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Server-only secret required to call /api/cron/fetch-standings in production.
CRON_SECRET=use_a_long_random_value_here

# Set to "true" to bypass the API entirely and serve src/data/mockStandings.js.
VITE_USE_MOCK_DATA=false
